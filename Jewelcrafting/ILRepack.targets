<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- One DLL: the helper libraries and YamlDotNet are merged in and internalized, as upstream does,
       so they cannot clash with other mods' copies of ServerSync, ItemManager and friends. -->
  <Target Name="ILRepacker" AfterTargets="Build">
    <ItemGroup>
      <MergeInputs Include="$(TargetPath)" />
      <MergeInputs Include="$(ProjectDir)Libs\*.dll" />
      <MergeInputs Include="$(TargetDir)YamlDotNet.dll" />
    </ItemGroup>
    <ILRepack Parallel="true" Internalize="true" InputAssemblies="@(MergeInputs)" OutputFile="$(TargetDir)merged\$(AssemblyName).dll"
              TargetKind="SameAsPrimaryAssembly" LibraryPath="$(TargetDir);$(Managed);$(R2MODMAN_PROFILE)\BepInEx\core" />
    <MakeDir Directories="$(R2MODMAN_PROFILE)\BepInEx\plugins\CarturJewelcrafting" />
    <Copy SourceFiles="$(TargetDir)merged\$(AssemblyName).dll" DestinationFolder="$(R2MODMAN_PROFILE)\BepInEx\plugins\CarturJewelcrafting" />
  </Target>
</Project>
