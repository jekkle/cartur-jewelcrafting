<Project Sdk="Microsoft.NET.Sdk">

  <!-- SDK-style build of Smoothbrain's Jewelcrafting source (blaxxun-boop/Jewelcrafting, used with
       their permission). Their Jewelcrafting.csproj expects publicized game DLLs written into the
       Valheim install; this one publicizes at build time instead, so nothing touches the game's files.
       AssemblyName, RootNamespace and the plugin GUID stay "Jewelcrafting": add-ons such as
       EpicJewels and CrystalLights reference Jewelcrafting.dll and its GUID directly, and the
       embedded resources are loaded by their "Jewelcrafting.*" names.

       Build:  dotnet build CarturJewelcrafting.csproj -c Release -->

  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <AssemblyName>Jewelcrafting</AssemblyName>
    <RootNamespace>Jewelcrafting</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RestoreAdditionalProjectSources>https://nuget.bepinex.dev/v3/index.json</RestoreAdditionalProjectSources>
    <VALHEIM_INSTALL Condition="'$(VALHEIM_INSTALL)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</VALHEIM_INSTALL>
    <R2MODMAN_PROFILE Condition="'$(R2MODMAN_PROFILE)' == ''">$(APPDATA)\r2modmanPlus-local\Valheim\profiles\Default</R2MODMAN_PROFILE>
    <Managed>$(VALHEIM_INSTALL)\valheim_Data\Managed</Managed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.2" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="HarmonyX" Version="2.10.1" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.40" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="assembly_valheim" Publicize="true"><HintPath>$(Managed)\assembly_valheim.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="assembly_utils" Publicize="true"><HintPath>$(Managed)\assembly_utils.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="assembly_guiutils" Publicize="true"><HintPath>$(Managed)\assembly_guiutils.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SoftReferenceableAssets" Publicize="true"><HintPath>$(Managed)\SoftReferenceableAssets.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Splatform"><HintPath>$(Managed)\Splatform.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(Managed)\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(Managed)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AnimationModule"><HintPath>$(Managed)\UnityEngine.AnimationModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AssetBundleModule"><HintPath>$(Managed)\UnityEngine.AssetBundleModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(Managed)\UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Managed)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(Managed)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(Managed)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ParticleSystemModule"><HintPath>$(Managed)\UnityEngine.ParticleSystemModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(Managed)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(Managed)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(Managed)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(Managed)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="Libs\*.dll" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="obj\**;bin\**" />
    <EmbeddedResource Include="translations\*.yml" />
    <EmbeddedResource Include="Effects\Jewelcrafting.Groups.yml;Effects\Jewelcrafting.Sockets.yml" />
    <EmbeddedResource Include="Synergy\Jewelcrafting.Synergy.yml;WorldBosses\Jewelcrafting.Gacha.yml" />
    <EmbeddedResource Include="Setup\Jewelcrafting.SocketCosts.yml;LootSystem\Jewelcrafting.Loot.yml" />
    <EmbeddedResource Include="icons\gem_cursor.png;assets\crystalcaseui;assets\jewelcrafting;assets\jc_ui_additions" />
  </ItemGroup>

  <!-- The merge into one DLL lives in ILRepack.targets, which the ILRepack package imports. -->

</Project>
